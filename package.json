{
  "name": "mona-tron-de",
  "version": "0.1.0",
  "description": "Trộn đề thi trắc nghiệm, đúng/sai và trả lời ngắn bằng seed tái lập",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "browser": "./dist/browser.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "mona-tron-de": "./dist/cli.js"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test",
    "lint": "node scripts/lint.mjs"
  },
  "engines": { "node": ">=18" },
  "repository": {
    "type": "git",
    "url": "https://github.com/mona-software/mona-tron-de.git"
  },
  "homepage": "https://github.com/mona-software/mona-tron-de#readme",
  "keywords": ["tron-de", "trac-nghiem", "giao-vien", "aiken", "gift", "moodle", "vietnam"],
  "license": "MIT"
}
